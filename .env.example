# Application Configuration
APP_NAME=AIOps Commander
APP_ENV=development
APP_DEBUG=true

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Anthropic Claude Configuration (for later phases)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Azure Configuration (for later phases)
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_RESOURCE_GROUP=your_resource_group_here

# AKS Configuration (for later phases)
AKS_CLUSTER_NAME=your_aks_cluster_name
AKS_RESOURCE_GROUP=your_aks_resource_group

# GitLab Configuration (for later phases)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_PROJECT_ID=your_project_id_here

# Azure Monitor Configuration (for later phases)
AZURE_MONITOR_WORKSPACE_ID=your_workspace_id_here
AZURE_MONITOR_SHARED_KEY=your_shared_key_here

# Application Insights (for later phases)
APPINSIGHTS_CONNECTION_STRING=your_connection_string_here

# Log Analytics (for later phases)
LOG_ANALYTICS_WORKSPACE_ID=your_workspace_id_here
LOG_ANALYTICS_QUERY_KEY=your_query_key_here
