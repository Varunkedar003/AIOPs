# Template for Streamlit Community Cloud's Secrets manager.
#
# Do NOT fill this in and commit it - it's a template only (the real file,
# .streamlit/secrets.toml, is gitignored). For local dev, keep using .env as before.
#
# To deploy: copy these keys (with real values) into your app's
# "Settings -> Secrets" box on https://share.streamlit.io - Streamlit injects
# them as environment variables that config.py already reads via os.getenv().

ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-sonnet-5"

AZURE_TENANT_ID = ""

# Staging and Production are different Service Principals (not one shared SP across
# both) - see dashboard/subscription_picker.py.
AZURE_CLIENT_ID_STAGING = ""
AZURE_CLIENT_SECRET_STAGING = ""
AZURE_CLIENT_ID_PRODUCTION = ""
AZURE_CLIENT_SECRET_PRODUCTION = ""

AZURE_SUBSCRIPTION_ID = ""
AZURE_SUBSCRIPTION_IDS = ""

GITLAB_URL = "https://gitlab.com"
GITLAB_TOKEN = ""

# Leave unset unless you have a reachable, internet-facing Ollama-compatible
# endpoint - there is no local Ollama daemon on Streamlit Community Cloud, so
# the CrewAI per-domain investigation agents (agents/crew/*) will report
# status="error" without it. The Claude Sonnet final synthesis (AI Copilot's
# main answer) does not depend on this and works normally either way.
# OLLAMA_BASE_URL = ""
# OLLAMA_MODEL = ""
